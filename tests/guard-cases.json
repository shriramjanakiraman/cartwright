{
  "_comment": "Guard cases for scripts/e2e-guard.mjs. Each case: a project setup, one tool call (shell / edit / write / patch shorthand, turned into each agent's payload shape, or a raw payload), and the expected decision. via \"hook\" runs it through the real hooks.json command for each listed agent; otherwise the guard is called in-process. Placeholders: {HOME} {TMPDIR} {STATE} {ALLOWED} {OUTSIDE} {PROJECT} {MACHINE} {TOKEN} {AWS} {PLUGIN}. {TOKEN} is a fake GitHub token made at run time; no secret is ever stored here.",
  "cases": [
    { "name": "D29 push to main is blocked and the remote is unchanged", "setup": "profiled", "via": "hook", "agents": ["claude-code", "copilot", "codex"], "shell": "git push origin main", "expect": "deny", "rule": "protected-branches", "includes": ["push to main, a protected branch", "git push -u origin <branch>", "they can run it themselves"], "remote": "unchanged" },
    { "name": "D29 HEAD:main", "setup": "profiled", "shell": "git push origin HEAD:main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 +main", "setup": "profiled", "shell": "git push origin +main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 --force", "setup": "profiled", "shell": "git push --force origin main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 --force-with-lease to develop", "setup": "profiled", "shell": "git push --force-with-lease origin feature:develop", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 deleting :develop", "setup": "profiled", "shell": "git push origin :develop", "expect": "deny", "rule": "protected-branches", "includes": ["delete develop"] },
    { "name": "D29 deleting with --delete", "setup": "profiled", "shell": "git push origin --delete main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 bare git push while tracking main", "setup": "profiled", "shell": "git push", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 git push origin with no refspec on main", "setup": "profiled", "shell": "git push origin", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 refs/heads/main", "setup": "profiled", "shell": "git push origin HEAD:refs/heads/main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D37 a glob in protectedBranches (release/*)", "setup": "profiled", "shell": "git push origin feature:release/2.0", "expect": "deny", "rule": "protected-branches", "includes": ["release/*"] },
    { "name": "D29 --all with a protected branch present", "setup": "profiled", "shell": "git push --all origin", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 --mirror", "setup": "profiled", "shell": "git push --mirror origin", "expect": "deny", "rule": "protected-branches" },
    { "name": "D29 an unresolvable destination", "setup": "profiled", "shell": "git push origin \"$SOME_BRANCH\"", "expect": "deny", "rule": "protected-branches", "includes": ["can't tell where this push goes"] },
    { "name": "D29 $(git branch --show-current) on main", "setup": "profiled", "shell": "git push origin $(git branch --show-current)", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 git -c before the subcommand", "setup": "profiled", "shell": "git -c push.default=current push origin main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 git -C to the project", "setup": "profiled", "shell": "cd / && git -C \"{PROJECT}\" push origin main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 sh -c", "setup": "profiled", "shell": "sh -c 'git push origin main'", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 bash -lc", "setup": "profiled", "shell": "bash -lc \"git push origin develop\"", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 eval", "setup": "profiled", "shell": "eval \"git push origin main\"", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 a variable set earlier on the line", "setup": "profiled", "shell": "B=main; git push origin $B", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 env and sudo wrappers", "setup": "profiled", "shell": "env GIT_TRACE=0 git push origin main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 a git alias", "setup": "profiled", "prepare": [["git", "config", "alias.ship", "push origin main"]], "shell": "git ship", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 a shell alias in git", "setup": "profiled", "prepare": [["git", "config", "alias.ship2", "!git push origin develop"]], "shell": "git ship2", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 an alias given with git -c", "setup": "profiled", "shell": "git -c alias.p=push p origin main", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 an alias set earlier on the same line", "setup": "profiled", "shell": "git config alias.ship \"push origin main\" && git ship", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 a shell alias given with git -c", "setup": "profiled", "shell": "git -c 'alias.go=!git push origin develop' go", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 xargs git push takes its destination from stdin", "setup": "profiled", "shell": "echo main | xargs git push origin", "expect": "deny", "rule": "protected-branches", "includes": ["can't tell where this push goes"] },
    { "name": "D32 xargs git add, then commit", "setup": "unprofiled", "shell": "git ls-files -m | xargs git add && git commit -m all", "expect": "deny", "rule": "secrets", "includes": ["can't tell which files were added", "name the files explicitly"] },
    { "name": "D32 a commit whose files come from a variable", "setup": "unprofiled", "shell": "git commit -m x -- $FILES", "expect": "deny", "rule": "secrets", "includes": ["can't tell which files this commit takes"], "excludes": ["couldn't check this safely"] },
    { "name": "D39 echo piped into sh", "setup": "profiled", "shell": "echo \"git push origin main\" | sh", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 printf piped into bash", "setup": "profiled", "shell": "printf 'git push origin develop\\n' | bash -s", "expect": "deny", "rule": "protected-branches" },
    { "name": "D39 echo piped into something that isn't a shell is just text", "setup": "profiled", "shell": "echo 'git push origin main' | grep push", "expect": "allow" },
    { "name": "D29 push in a command substitution", "setup": "profiled", "shell": "echo $(git push origin main)", "expect": "deny", "rule": "protected-branches" },
    { "name": "D30 pushing a feature branch goes through", "setup": "profiled", "via": "hook", "agents": ["claude-code", "copilot", "codex"], "prepare": [["git", "checkout", "-q", "-b", "feature/x"]], "shell": "git push -u origin feature/x", "expect": "allow", "run": true, "remote": "has:feature/x" },
    { "name": "D30 tags are allowed", "setup": "profiled", "prepare": [["git", "tag", "v1.0.0"]], "shell": "git push origin v1.0.0", "expect": "allow" },
    { "name": "D30 --tags is allowed", "setup": "profiled", "shell": "git push --tags", "expect": "allow" },
    { "name": "D30 reading git state is allowed", "setup": "profiled", "shell": "git log --oneline -3 && git status", "expect": "allow" },
    { "name": "D31 unprofiled: pushing to main isn't blocked", "setup": "unprofiled", "via": "hook", "agents": ["claude-code"], "shell": "git push origin main", "expect": "allow" },
    { "name": "D31 unprofiled: committing a secret is blocked", "setup": "unprofiled", "prepare": [["write", "src/leak.ts", "export const t = '{TOKEN}';\n"], ["git", "add", "src/leak.ts"]], "shell": "git commit -m leak", "expect": "deny", "rule": "secrets" },
    { "name": "D31 unprofiled: deleting outside the project is blocked", "setup": "unprofiled", "shell": "rm -rf {HOME}/precious", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "D31 unprofiled: editing src/generated is allowed (no settings)", "setup": "unprofiled", "edit": { "path": "src/generated/api.ts", "before": "id: string", "after": "id: number" }, "expect": "allow" },
    { "name": "D32 a staged token is blocked; the file is named, the value isn't shown", "setup": "profiled", "via": "hook", "agents": ["claude-code", "copilot", "codex"], "prepare": [["write", "src/leak.ts", "export const t = '{TOKEN}';\n"], ["git", "add", "src/leak.ts"]], "shell": "git commit -m leak", "expect": "deny", "rule": "secrets", "includes": ["src/leak.ts:1", "GitHub token", "value isn't shown"], "excludes": ["{TOKEN}"] },
    { "name": "D32 git add then commit on one line", "setup": "profiled", "prepare": [["write", "src/leak.ts", "const t = '{TOKEN}';\n"]], "shell": "git add src/leak.ts && git commit -m leak", "expect": "deny", "rule": "secrets", "excludes": ["{TOKEN}"] },
    { "name": "D32 git add -A then commit", "setup": "profiled", "prepare": [["write", "docs/notes.md", "token {TOKEN}\n"]], "shell": "git add -A; git commit -m notes", "expect": "deny", "rule": "secrets" },
    { "name": "D32 commit -am with a changed tracked file", "setup": "profiled", "prepare": [["append", "src/server.ts", "const k = '{TOKEN}';\n"]], "shell": "git commit -am change", "expect": "deny", "rule": "secrets" },
    { "name": "D32 an AWS key in a staged file", "setup": "profiled", "prepare": [["write", "config.json", "{ \"key\": \"AKIA{AWS}\" }\n"], ["git", "add", "config.json"]], "shell": "git commit -m cfg", "expect": "deny", "rule": "secrets", "includes": ["AWS access key"] },
    { "name": "D32 committing .env is blocked by its name", "setup": "profiled", "prepare": [["write", ".env", "A=1\n"]], "shell": "git add .env && git commit -m env", "expect": "deny", "rule": "secrets", "includes": [".env would be committed"] },
    { "name": "D32 .env.example is fine", "setup": "profiled", "prepare": [["write", ".env.example", "A=\n"], ["git", "add", ".env.example"]], "shell": "git commit -m example", "expect": "allow" },
    { "name": "D32 a clean commit goes through and runs", "setup": "profiled", "via": "hook", "agents": ["claude-code"], "prepare": [["append", "src/server.ts", "// fine\n"], ["git", "add", "src/server.ts"]], "shell": "git commit -m fine", "expect": "allow", "run": true, "committed": "fine" },
    { "name": "D37 secrets.allow lets the team's test fakes through", "setup": "profiled", "prepare": [["write", "tests/fixtures/fake.ts", "export const t = '{TOKEN}';\n"], ["git", "add", "tests/fixtures/fake.ts"]], "shell": "git commit -m fakes", "expect": "allow" },
    { "name": "D33 Claude Edit of a generated file", "setup": "profiled", "via": "hook", "agents": ["claude-code", "copilot", "codex"], "edit": { "path": "src/generated/api.ts", "before": "id: string", "after": "id: number" }, "expect": "deny", "rule": "generated-files", "includes": ["src/generated/api.ts is generated", "run pnpm generate:api"] },
    { "name": "D33 Write over a generated file", "setup": "profiled", "agents": ["claude-code", "copilot", "codex"], "write": { "path": "src/generated/api.ts", "content": "export {};\n" }, "expect": "deny", "rule": "generated-files" },
    { "name": "D33 a new file under a generated folder", "setup": "profiled", "agents": ["claude-code", "copilot", "codex"], "write": { "path": "src/generated/extra.ts", "content": "export {};\n" }, "expect": "deny", "rule": "generated-files" },
    { "name": "D33 shell redirect onto a generated file", "setup": "profiled", "via": "hook", "agents": ["claude-code"], "shell": "echo '// x' > src/generated/api.ts", "expect": "deny", "rule": "generated-files", "includes": ["pnpm generate:api"] },
    { "name": "D33 appending with >>", "setup": "profiled", "shell": "printf 'x' >> src/generated/api.ts", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 a here-document", "setup": "profiled", "shell": "cat > src/generated/api.ts <<'EOF'\nexport {};\nEOF", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 sed -i", "setup": "profiled", "shell": "sed -i.bak 's/id/key/' src/generated/api.ts", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 perl -pi", "setup": "profiled", "shell": "perl -pi -e 's/id/key/' src/generated/api.ts", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 tee", "setup": "profiled", "shell": "echo x | tee src/generated/api.ts", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 cp onto it", "setup": "profiled", "shell": "cp src/server.ts src/generated/api.ts", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 cp into a generated folder", "setup": "profiled", "shell": "cp src/server.ts src/generated/", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 mv onto it", "setup": "profiled", "shell": "mv src/server.ts src/generated/api.ts", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 inside sh -c", "setup": "profiled", "shell": "sh -c \"printf x > src/generated/api.ts\"", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 git apply of a patch file in the project", "setup": "profiled", "prepare": [["write", "fix.patch", "--- a/src/generated/api.ts\n+++ b/src/generated/api.ts\n@@ -1 +1 @@\n-x\n+y\n"]], "shell": "git apply fix.patch", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 Codex apply_patch, absolute path", "setup": "profiled", "agents": ["codex"], "patch": "*** Begin Patch\n*** Update File: {PROJECT}/src/generated/api.ts\n@@\n-  id: string;\n+  id: number;\n*** End Patch", "expect": "deny", "rule": "generated-files" },
    { "name": "D33 running the regenerate command is allowed", "setup": "profiled", "shell": "pnpm generate:api", "expect": "allow" },
    { "name": "D33 reading, restoring and deleting are allowed", "setup": "profiled", "shell": "cat src/generated/api.ts && git checkout -- src/generated/api.ts && git restore src/generated/api.ts", "expect": "allow" },
    { "name": "D33 editing a file that isn't generated", "setup": "profiled", "via": "hook", "agents": ["claude-code", "copilot", "codex"], "edit": { "path": "src/server.ts", "before": "ok: true", "after": "ok: false" }, "expect": "allow" },
    { "name": "D34 deleting a folder in the home folder", "setup": "profiled", "via": "hook", "agents": ["claude-code", "copilot", "codex"], "shell": "rm -rf ~/precious", "expect": "deny", "rule": "destructive-outside-project", "includes": ["outside this project"] },
    { "name": "D34 overwriting an existing file outside", "setup": "profiled", "shell": "echo x > ~/.zshrc", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "D34 editing an existing file outside", "setup": "profiled", "agents": ["claude-code", "copilot", "codex"], "edit": { "path": "{HOME}/.zshrc", "before": "export A=1", "after": "export A=2" }, "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "D34 find -delete outside", "setup": "profiled", "shell": "find ~/precious -name '*.txt' -delete", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "D34 moving a file out of the home folder", "setup": "profiled", "shell": "mv ~/precious/file.txt ./", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "D34 a glob outside", "setup": "profiled", "shell": "rm -f {OUTSIDE}/*.log", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "D34 an unresolvable target", "setup": "profiled", "shell": "rm -rf \"$NOT_SET\"/cache", "expect": "deny", "rule": "destructive-outside-project", "includes": ["can't tell where"] },
    { "name": "D34 rm -rf / is blocked", "setup": "unprofiled", "shell": "rm -rf /", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "D34 deleting inside the project is allowed", "setup": "profiled", "via": "hook", "agents": ["claude-code"], "shell": "rm -rf dist build && rm -f src/server.ts", "expect": "allow" },
    { "name": "D35 deleting in the moved temporary folder is allowed", "setup": "profiled", "shell": "rm -rf $TMPDIR/scratch && rm -rf {TMPDIR}/other", "expect": "allow" },
    { "name": "D35 deleting in Cartwright's cache is allowed", "setup": "profiled", "shell": "rm -rf {STATE}/cache/b2c", "expect": "allow" },
    { "name": "D35 creating a new file outside isn't destructive", "setup": "profiled", "shell": "touch ~/new-file && echo x > ~/another-new-file", "expect": "allow" },
    { "name": "D35 appending outside isn't destructive", "setup": "profiled", "shell": "echo 'export A=2' >> ~/.zshrc", "expect": "allow" },
    { "name": "D36 an allowed location", "setup": "profiled", "shell": "rm -rf {ALLOWED}/old", "expect": "allow" },
    { "name": "D36 a protected location inside the project", "setup": "profiled", "shell": "rm -rf vault/keys", "expect": "deny", "rule": "destructive-outside-project", "includes": ["locations.protected"] },
    { "name": "D37 a project shell rule", "setup": "profiled", "shell": "npx deploy --prod", "expect": "deny", "rule": "project-rules:no-prod-deploy", "includes": ["Production deploys go through the pipeline"] },
    { "name": "D37 a project path rule", "setup": "profiled", "edit": { "path": "vendor/lib.js", "before": "a", "after": "b" }, "expect": "deny", "rule": "project-rules:no-edit-vendor" },
    { "name": "D37 rules switched off: pushing to main", "setup": "switched-off", "shell": "git push origin main", "expect": "allow" },
    { "name": "D37 rules switched off: editing a generated file", "setup": "switched-off", "edit": { "path": "src/generated/api.ts", "before": "id: string", "after": "id: number" }, "expect": "allow" },
    { "name": "D38 editing the settings needs the person", "setup": "profiled", "via": "hook", "agents": ["claude-code", "copilot", "codex"], "edit": { "path": ".cartwright/settings.json", "before": "\"generated-files\": true", "after": "\"generated-files\": false" }, "expect": "deny", "rule": "guardrail-files", "includes": ["only the person can approve", "profile.mjs\" write"] },
    { "name": "D38 a shell write to the settings", "setup": "profiled", "shell": "echo '{}' > .cartwright/settings.json", "expect": "deny", "rule": "guardrail-files" },
    { "name": "D38 deleting the .cartwright folder", "setup": "profiled", "shell": "rm -rf .cartwright", "expect": "deny", "rule": "guardrail-files" },
    { "name": "D38 profile.mjs write shows the person the exact command", "setup": "profiled", "shell": "node {PLUGIN}/tools/profile.mjs write --store folder --protected main --generated none", "expect": "deny", "rule": "guardrail-files", "includes": ["run in their own terminal: node {PLUGIN}/tools/profile.mjs write --store folder --protected main --generated none"] },
    { "name": "D34 rm -rf * in an unprofiled project is allowed", "setup": "unprofiled", "shell": "rm -rf *", "expect": "allow" },
    { "name": "D38 rm -rf * leaves the hidden .cartwright folder alone", "setup": "profiled", "shell": "rm -rf *", "expect": "allow" },
    { "name": "D38 a glob starting with a dot covers .cartwright", "setup": "profiled", "shell": "rm -rf .c*", "expect": "deny", "rule": "guardrail-files" },
    { "name": "D38 moving the .cartwright folder away", "setup": "profiled", "shell": "mv .cartwright /tmp/cw-backup", "expect": "deny", "rule": "guardrail-files" },
    { "name": "D38 AGENTS.md mode: rm -f * deletes AGENTS.md", "setup": "agents-md", "shell": "rm -f *", "expect": "deny", "rule": "guardrail-files", "includes": ["Cartwright section of AGENTS.md"] },
    { "name": "D38 the personal file is the developer's own", "setup": "profiled", "write": { "path": ".cartwright/personal.json", "content": "{ \"cartwright\": \"personal\", \"version\": 1 }\n" }, "expect": "allow" },
    { "name": "D38 AGENTS.md mode: an edit inside the section", "setup": "agents-md", "agents": ["claude-code", "copilot", "codex"], "edit": { "path": "AGENTS.md", "before": "\"generated-files\": true", "after": "\"generated-files\": false" }, "expect": "deny", "rule": "guardrail-files", "includes": ["Cartwright section of AGENTS.md"] },
    { "name": "D38 AGENTS.md mode: an edit outside the section is fine", "setup": "agents-md", "agents": ["claude-code", "copilot"], "edit": { "path": "AGENTS.md", "before": "Keep handlers small.", "after": "Keep handlers small and pure." }, "expect": "allow" },
    { "name": "D38 AGENTS.md mode: a shell write to AGENTS.md", "setup": "agents-md", "shell": "echo more >> AGENTS.md", "expect": "deny", "rule": "guardrail-files" },
    { "name": "D38 machine mode: the machine copy of the settings", "setup": "machine", "shell": "echo '{}' > {MACHINE}/settings.json", "expect": "deny", "rule": "guardrail-files" },
    { "name": "D38 self-protection: disabling the plugin", "setup": "unprofiled", "shell": "claude plugin disable cartwright@cartwright", "expect": "deny", "rule": "guardrail-files", "includes": ["switch its guardrails off"] },
    { "name": "D38 self-protection: disableAllHooks in agent settings", "setup": "unprofiled", "write": { "path": ".claude/settings.json", "content": "{ \"disableAllHooks\": true }\n" }, "expect": "deny", "rule": "guardrail-files" },
    { "name": "D40 broken settings: push to main still blocked, with the warning", "setup": "broken", "via": "hook", "agents": ["claude-code"], "shell": "git push origin main", "expect": "deny", "rule": "protected-branches", "includes": ["can't be used", "Built-in protections are on and the project's own rules are paused"] },
    { "name": "D40 broken settings: a detected candidate (develop) is protected", "setup": "broken", "shell": "git push origin feature:develop", "expect": "deny", "rule": "protected-branches" },
    { "name": "D40 broken settings: generated files from the profile, command not recorded", "setup": "broken", "edit": { "path": "src/generated/api.ts", "before": "id: string", "after": "id: number" }, "expect": "deny", "rule": "generated-files", "includes": ["isn't recorded while the settings are broken"] },
    { "name": "D40 broken settings: the project's own rules pause", "setup": "broken", "shell": "npx deploy --prod", "expect": "allow" },
    { "name": "D40 broken settings: allowed locations pause", "setup": "broken", "shell": "rm -rf {ALLOWED}/old", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "B18 personal file: a rule the team switched off is on for me", "setup": "personal-tighten", "edit": { "path": "src/generated/api.ts", "before": "id: string", "after": "id: number" }, "expect": "deny", "rule": "generated-files" },
    { "name": "B18 personal file: my extra protected branch", "setup": "personal-tighten", "shell": "git push origin feature:staging", "expect": "deny", "rule": "protected-branches" },
    { "name": "B19 personal file can't switch secrets off, and says so", "setup": "personal-loosen", "prepare": [["write", "src/leak.ts", "const t = '{TOKEN}';\n"], ["git", "add", "src/leak.ts"]], "shell": "git commit -m leak", "expect": "deny", "rule": "secrets", "includes": ["personal file tries to switch this off"] },
    { "name": "B19 personal file can't unprotect main", "setup": "personal-loosen", "shell": "git push origin main", "expect": "deny", "rule": "protected-branches" },
    { "name": "E46 an allowed commit still runs the project's own git hook", "setup": "husky", "via": "hook", "agents": ["claude-code"], "prepare": [["append", "src/server.ts", "// fine\n"], ["git", "add", "src/server.ts"]], "shell": "git commit -m fine", "expect": "allow", "run": true, "exists": ".husky-ran" },
    { "name": "5.7 unknown tools are allowed", "setup": "profiled", "via": "hook", "agents": ["claude-code"], "payload": { "tool_name": "WebFetch", "tool_input": { "url": "https://example.com" }, "cwd": "{PROJECT}" }, "expect": "allow" },
    { "name": "5.7 an edit tool with no path near generated files is denied", "setup": "profiled", "payload": { "tool_name": "Edit", "tool_input": { "old_string": "a", "new_string": "b" }, "cwd": "{PROJECT}" }, "expect": "deny", "rule": "generated-files", "includes": ["couldn't tell which file"] },
    { "name": "5.3 Copilot's camelCase payload", "setup": "profiled", "agents": ["copilot-camel"], "shell": "git push origin main", "expect": "deny", "rule": "protected-branches" },

    { "name": "G2 through a symlinked folder in the project (trailing slash)", "setup": "profiled", "prepare": [["symlink", "{HOME}/precious", "homelink"]], "shell": "rm -rf homelink/", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "G2 through a symlinked folder in the project (glob)", "setup": "profiled", "prepare": [["symlink", "{HOME}/precious", "homelink"]], "shell": "rm -rf homelink/*", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "G2 through a symlinked folder (trailing /.)", "setup": "profiled", "prepare": [["symlink", "{HOME}/precious", "homelink"]], "shell": "rm -rf homelink/.", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "G2 removing the link itself is fine", "setup": "profiled", "prepare": [["symlink", "{HOME}/precious", "homelink"]], "shell": "rm homelink && unlink homelink", "expect": "allow" },
    { "name": "G2 through a symlink inside the temporary folder (glob)", "setup": "profiled", "prepare": [["symlink", "{HOME}/precious", "{TMPDIR}/g2-glob/d"]], "shell": "rm -rf $TMPDIR/g2-glob/d/*", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "G2 find from a symlinked start point in the temporary folder", "setup": "profiled", "prepare": [["symlink", "{HOME}/precious", "{TMPDIR}/g2-find/d"]], "shell": "find $TMPDIR/g2-find/d/ -type f -delete", "expect": "deny", "rule": "destructive-outside-project" },
    { "name": "D35 deleting in the moved temporary folder is allowed", "setup": "profiled", "shell": "rm -rf $TMPDIR/scratch && rm -rf {TMPDIR}/other", "expect": "allow" },

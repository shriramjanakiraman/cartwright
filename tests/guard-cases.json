    { "name": "G5 git clean -fd leaves the ignored personal file", "setup": "profiled", "shell": "git clean -fd", "expect": "allow", "prepare": [["write", ".cartwright/personal.json", "{ \"cartwright\":  \"personal\", \"version\":  1 }\n"]] },
    { "name": "G5 git reset --hard with uncommitted settings changes", "setup": "profiled", "shell": "git reset --hard", "expect": "deny", "rule": "guardrail-files", "prepare": [["append", ".cartwright/settings.json", "\n"]] },

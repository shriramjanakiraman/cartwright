    { "name": "G5 git stash with uncommitted settings changes", "setup": "profiled", "shell": "git stash", "expect": "deny", "rule": "guardrail-files", "prepare": [["append", ".cartwright/settings.json", "\n"]] },
    { "name": "G5 git stash -u with an untracked file in .cartwright", "setup": "profiled", "shell": "git stash -u", "expect": "deny", "rule": "guardrail-files", "prepare": [["write", ".cartwright/extra.json", "{}\n"]] },

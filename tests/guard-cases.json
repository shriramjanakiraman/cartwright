    { "name": "G5 git clean -fd with an untracked file in .cartwright", "setup": "profiled", "shell": "git clean -fd", "expect": "deny", "rule": "guardrail-files", "prepare": [["write", ".cartwright/extra.json", "{}\n"]] },
    { "name": "G5 git clean -fd with nothing to lose in .cartwright", "setup": "profiled", "shell": "git clean -fd", "expect": "allow", "prepare": [["write", "scratch.txt", "x\n"]] },
